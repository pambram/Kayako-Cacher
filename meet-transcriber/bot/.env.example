MEET_URL=https://meet.google.com/xxx-yyy-zzz
GOOGLE_EMAIL=meetbot@yourorg.com
GOOGLE_PASSWORD=replace-me
ANTHROPIC_API_KEY=sk-ant-...

CAPTURE_INTERVAL=10
BATCH_SIZE=6
ANALYSIS_MODEL=claude-haiku-4-5
SUMMARY_MODEL=claude-sonnet-4-6
TLDR_MODEL=claude-sonnet-4-6
ARC_MODEL=claude-sonnet-4-6
BULLETS_MODEL=claude-sonnet-4-6
MAX_MEETING_MINUTES=240
HEADLESS=false
CHROME_BIN=
GUEST_NAME=Meet Bot
FORCE_GOOGLE_SIGNIN=false
JOIN_WAIT_SEC=180
ENABLE_STEALTH=true
CHECKPOINT_UPLOAD_ENABLED=true
CHECKPOINT_UPLOAD_MINUTES=5
STRICT_PROMPT_PARITY=true
ALLOW_PROMPT_FALLBACK=false
OUTPUT_DIR=./bot-output

AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=meet-transcriber/bot
SNS_TOPIC_ARN=
NOTIFY_EMAIL=pablo.ambram@trilogy.com
SES_FROM_EMAIL=pablo.ambram@trilogy.com
