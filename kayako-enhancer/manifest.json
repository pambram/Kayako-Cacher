{
  "manifest_version": 3,
  "name": "Kayako QoL Enhancer",
  "version": "1.11.4",
  "description": "Kayako QoL improvements: ticket history with unread activity, auto-sizing editors, resize editors, hide elements, remove timeline max-width, auto-hyperlink URLs, and Cmd+K shortcuts.",
  "permissions": ["cookies", "scripting", "activeTab", "storage", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.bundled.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.kayako.com/agent/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}