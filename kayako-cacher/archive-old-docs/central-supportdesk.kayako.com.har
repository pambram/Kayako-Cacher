\": \"\",\n            \"subject\": \"Xavier A Villarroel updated DNN License Add-On for Suffolk County Govt\",\n            \"contents\": \"Xavier A Villarroel updated DNN License Add-On for Suffolk County Govt\",\n            \"creator\": {\n                \"id\": 20,\n                \"resource_type\": \"user\"\n            },\n            \"identity\": {\n                \"id\": 21,\n                \"resource_type\": \"identity_email\"\n            },\n            \"source_channel\": null,\n            \"attachments\": [],\n            \"download_all\": null,\n            \"destination_medium\": null,\n            \"source\": null,\n            \"metadata\": {\n                \"user_agent\": \"\",\n                \"page_url\": \"\"\n            },\n            \"original\": {\n                \"id\": 193738138,\n                \"resource_type\": \"activity\"\n            },\n            \"post_status\": \"DELIVERED\",\n            \"post_status_reject_type\": null,\n            \"post_status_reject_reason\": null,\n            \"post_status_updated_at\": \"2025-09-04T19:50:17+00:00\",\n            \"is_requester\": false,\n            \"created_at\": \"2025-09-04T19:50:17+00:00\",\n            \"updated_at\": \"2025-09-04T19:50:17+00:00\",\n            \"resource_type\": \"post\",\n            \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/posts/21762059\"\n        },\n        {\n            \"id\": 21762058,\n            \"uuid\": \"d7abc332-fc23-40fa-b403-fa123766984d\",\n            \"client_id\": \"cadfc535-5293-465b-8142-163955e95e2f\",\n            \"subject\": \"DNN License Add-On for Suffolk County Govt\",\n            \"contents\": \"Dear Customer,\\n\\nThank you for bringing this matter to our attention. We have escalated the approval notification issue related to account 221013 – Vanderbilt University Medical Center to our Professional Services team. \\n\\nThey will perform a detailed investigation to identify why the notifications are being sent incorrectly and work on applying the necessary fix.\\n\\nRest assured that we will keep you informed of any progress, and we will notify you immediately once the issue has been resolved.\\n\\nKind regards,\\nXavier Villarroel\\n@Hand Support Team\",\n            \"creator\": {\n                \"id\": 20,\n                \"resource_type\": \"user\"\n            },\n            \"identity\": {\n                \"id\": 21,\n                \"resource_type\": \"identity_email\"\n            },\n            \"source_channel\": {\n                \"id\": \"e1588c39-25e1-42f2-a241-bb3d4f5a7ab9\",\n                \"resource_type\": \"channel\"\n            },\n            \"attachments\": [],\n            \"download_all\": null,\n            \"destination_medium\": \"MAIL\",\n            \"source\": null,\n            \"metadata\": {\n                \"user_agent\": \"\",\n                \"page_url\": \"\"\n            },\n            \"original\": {\n                \"id\": 9677162,\n                \"resource_type\": \"case_message\"\n            },\n            \"post_status\": \"SEEN\",\n            \"post_status_reject_type\": null,\n            \"post_status_reject_reason\": null,\n            \"post_status_updated_at\": \"2025-09-04T20:59:16+00:00\",\n            \"is_requester\": false,\n            \"created_at\": \"2025-09-04T19:50:17+00:00\",\n            \"updated_at\": \"2025-09-04T20:59:16+00:00\",\n            \"resource_type\": \"post\",\n            \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/posts/21762058\"\n        },\n        {\n            \"id\": 21576770,\n            \"uuid\": \"3f057344-e6dc-40c9-a482-286397bd663b\",\n            \"client_id\": \"\",\n            \"subject\": \"Hermes updated DNN License Add-On for Suffolk County Govt\",\n            \"contents\": \"Hermes updated DNN License Add-On for Suffolk County Govt\",\n            \"creator\": {\n                \"id\": 1457,\n      