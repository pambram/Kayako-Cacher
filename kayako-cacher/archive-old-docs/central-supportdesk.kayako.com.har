        \"is_requester\": false,\n            \"created_at\": \"2025-09-04T23:10:45+00:00\",\n            \"updated_at\": \"2025-09-04T23:10:45+00:00\",\n            \"resource_type\": \"post\",\n            \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/posts/21766114\"\n        },\n        {\n            \"id\": 21766113,\n            \"uuid\": \"82d3cc04-2dd1-46d6-b8b5-a663480d2a4c\",\n            \"client_id\": \"\",\n            \"subject\": \"Trigger Reopen Dependent Tickets used Dependent Ticket Reopener\",\n            \"contents\": \"Trigger Reopen Dependent Tickets used Dependent Ticket Reopener\",\n            \"creator\": {\n                \"id\": 355,\n                \"resource_type\": \"trigger\"\n            },\n            \"identity\": null,\n            \"source_channel\": null,\n            \"attachments\": [],\n            \"download_all\": null,\n            \"destination_medium\": null,\n            \"source\": null,\n            \"metadata\": {\n                \"user_agent\": \"\",\n                \"page_url\": \"\"\n            },\n            \"original\": {\n                \"id\": 193875961,\n                \"resource_type\": \"activity\"\n            },\n            \"post_status\": \"DELIVERED\",\n            \"post_status_reject_type\": null,\n            \"post_status_reject_reason\": null,\n            \"post_status_updated_at\": \"2025-09-04T23:10:44+00:00\",\n            \"is_requester\": false,\n            \"created_at\": \"2025-09-04T23:10:44+00:00\",\n            \"updated_at\": \"2025-09-04T23:10:44+00:00\",\n            \"resource_type\": \"post\",\n            \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/posts/21766113\"\n        },\n        {\n            \"id\": 21766112,\n            \"uuid\": \"00d17e8b-957e-41ce-a206-403888b53183\",\n            \"client_id\": \"\",\n            \"subject\": \"Xavier A Villarroel updated DNN License Add-On for Suffolk County Govt\",\n            \"contents\": \"Xavier A Villarroel updated DNN License Add-On for Suffolk County Govt\",\n            \"creator\": {\n                \"id\": 20,\n                \"resource_type\": \"user\"\n            },\n            \"identity\": {\n                \"id\": 21,\n                \"resource_type\": \"identity_email\"\n            },\n            \"source_channel\": null,\n            \"attachments\": [],\n            \"download_all\": null,\n            \"destination_medium\": null,\n            \"source\": null,\n            \"metadata\": {\n                \"user_agent\": \"\",\n                \"page_url\": \"\"\n            },\n            \"original\": {\n                \"id\": 193875955,\n                \"resource_type\": \"activity\"\n            },\n            \"post_status\": \"DELIVERED\",\n            \"post_status_reject_type\": null,\n            \"post_status_reject_reason\": null,\n            \"post_status_updated_at\": \"2025-09-04T23:10:44+00:00\",\n            \"is_requester\": false,\n            \"created_at\": \"2025-09-04T23:10:44+00:00\",\n            \"updated_at\": \"2025-09-04T23:10:44+00:00\",\n            \"resource_type\": \"post\",\n            \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/posts/21766112\"\n        },\n        {\n            \"id\": 21766111,\n            \"uuid\": \"ebcafe7d-168b-40b4-8731-374b7a41ce64\",\n            \"client_id\": \"1a16d4e4-abf9-472f-ac3f-79958715997a\",\n            \"subject\": \"DNN License Add-On for Suffolk County Govt\",\n            \"contents\": \"Hi Byron, \\n\\nThank you for contacting customer support. \\n\\nI understand that Upsell opportunity signed for 2 additional non-production licenses.\\n\\nI tried looking for this customer in our Customer's database, but I couldn't find anything. \\n\\n[img src=\\\"https://i.imgur.com/9VSUjDd.png\\\" style=\\\"width: 52.19%;\\\" width=\\\"52.19%\\\" height=\\\"993.219\\\"]\\n\\nIs there any other name this customer uses so we can find it?\\n\\nWe also searched for upsell and the emails and found no matches. \\n\\nOnce you get back to us, we can continue working on the ticket.\\n\\nWe look forward to hearing back from you soon. In the meantime, if you have any questions or concerns, please don't hesitate to reach out; we would be happy to help.\\n\\nBest regards,\\nXavier A Villarroel\\nDNN Support Team\\n\\nThis ticket will stay open for one week unless you reply with \\\"This ticket can be closed\\\" or update the status to Completed in the portal. We will write to you again to remind you.\",\n            \"creator\": {\n                \"id\": 20,\n                \"resource_type\": \"user\"\n            },\n            \"identity\": {\n                \"id\": 21,\n                \"resource_type\": \"identity_email\"\n            },\n            \"source_channel\": {\n                \"id\": \"e1588c39-25e1-42f2-a241-bb3d4f5a7ab9\",\n                \"resource_type\": \"channel\"\n            },\n            \"attachments\": [],\n            \"download_all\": null,\n            \"destination_medium\": \"MAIL\",\n            \"source\": null,\n            \"metadata\": {\n                \"user_agent\": \"\",\n                \"page_url\": \"\"\n            },\n            \"original\": {\n                \"id\": 9677423,\n                \"resource_type\": \"case_message\"\n            },\n            \"post_status\": \"SEEN\",\n            \"post_status_reject_type\": null,\n            \"post_status_reject_reason\": null,\n            \"post_status_updated_at\": \"2025-09-04T23:15:15+00:00\",\n            \"is_requester\": false,\n            \"created_at\": \"2025-09-04T23:10:43+00:00\",\n            \"updated_at\": \"2025-09-04T23:15:15+00:00\",\n            \"resource_type\": \"post\",\n            \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/posts/21766111\"\n        },\n        {\n            \"id\": 21766110,\n            \"