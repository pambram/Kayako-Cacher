                     \"id\": 375,\n                        \"resource_type\": \"case_field\"\n                    },\n                    {\n                        \"id\": 127,\n                        \"resource_type\": \"case_field\"\n                    },\n                    {\n                        \"id\": 615,\n                        \"resource_type\": \"case_field\"\n                    }\n                ],\n                \"brand\": {\n                    \"id\": 60000050,\n                    \"resource_type\": \"brand\"\n                },\n                \"created_at\": \"2025-02-07T08:30:35+00:00\",\n                \"updated_at\": \"2025-07-21T13:03:07+00:00\",\n                \"resource_type\": \"case_form\",\n                \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/forms/52\"\n            }\n        },\n        \"case_message\": {\n            \"9677423\": {\n                \"id\": 9677423,\n                \"uuid\": \"ebcafe7d-168b-40b4-8731-374b7a41ce64\",\n                \"subject\": \"DNN License Add-On for Suffolk County Govt\",\n                \"body_text\": \"Hi Byron, \\n\\nThank you for contacting customer support. \\n\\nI understand that Upsell opportunity signed for 2 additional non-production licenses.\\n\\nI tried looking for this customer in our Customer's database, but I couldn't find anything. \\n\\n[img src=\\\"https://i.imgur.com/9VSUjDd.png\\\" style=\\\"width: 52.19%;\\\" width=\\\"52.19%\\\" height=\\\"993.219\\\"]\\n\\nIs there any other name this customer uses so we can find it?\\n\\nWe also searched for upsell and the emails and found no matches. \\n\\nOnce you get back to us, we can continue working on the ticket.\\n\\nWe look forward to hearing back from you soon. In the meantime, if you have any questions or concerns, please don't hesitate to reach out; we would be happy to help.\\n\\nBest regards,\\nXavier A Villarroel\\nDNN Support Team\\n\\nThis ticket will stay open for one week unless you reply with \\\"This ticket can be closed\\\" or update the status to Completed in the portal. We will write to you again to remind you.\",\n                \"body_html\": \"<div>Hi Byron,&nbsp;</div><div><br></div><div>Thank you for contacting customer support.&nbsp;</div><div><br>I understand that Upsell opportunity signed for 2 additional non-production licenses.</div><div><br></div><div>I tried looking for this customer in our Customer's database, but I couldn't find anything.&nbsp;</div><div><br></div><div><img src=\\\"https://i.imgur.com/9VSUjDd.png\\\" style=\\\"width: 52.19%;\\\" width=\\\"52.19%\\\" height=\\\"993.219\\\"><br><br>Is there any other name this customer uses so we can find it?<br><br>We also searched for <strong>upsell</strong> and the <strong>emails</strong> and found no matches.&nbsp;</div><div><br></div><div>Once you get back to us, we can continue working on the ticket.<br><br>We look forward to hearing back from you soon. In the meantime, if you have any questions or concerns, please don't hesitate to reach out; we would be happy to help.</div><div><br></div><div>Best regards,</div><div>Xavier A Villarroel</div><div>DNN Support Team</div><div data-empty=\\\"true\\\"><br></div><div>This ticket will stay open for one week unless you reply with \\\"<strong>This ticket can be closed</strong>\\\" or update the status to Completed in the portal. We will write to you again to remind you.</div>\",\n                \"recipients\": [],\n                \"fullname\": \"Xavier A Villarroel\",\n                \"email\": \"support@central-supportdesk.kayako.com\",\n                \"creator\": {\n                    \"id\": 20,\n                    \"resource_type\": \"user\"\n                },\n                \"identity\": {\n                    \"id\": 21,\n                    \"resource_type\": \"identity_email\"\n                },\n                \"mailbox\": {\n                    \"id\": 4,\n                    \"resource_type\": \"mailbox\"\n                },\n                \"attachments\": [],\n                \"download_all\": null,\n                \"locale\": null,\n                \"response_time\": 0,\n                \"created_at\": \"2025-09-04T23:10:43+00:00\",\n                \"updated_at\": \"2025-09-04T23:10:43+00:00\",\n                \"resource_type\": \"case_message\",\n                \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/60182386/messages/9677423\"\n            },\n            \"9677165\": {\n                \"id\": 9677165,\n                \"uuid\": \"5c474ee7-5a1e-4ce0-aec3-49d1c924fda2\",\n                \"subject\": \"DNN License Add-On for Suffolk County Govt\",\n                \"body_text\": \"Hi Byron, \\n\\nDisregard my last update please, I am working on this case right now. \\n\\nRegards,\\nXavier Villarroel\\nDNN Customer Support. \",\n                \"body_html\": \"<div>Hi Byron,&nbsp;</div><div><br></div><div>Disregard my last update please, I am working on this case right now.&nbsp;</div><div><br></div><div>Regards,</div><div>Xavier Villarroel</div><div>DNN Customer Support.&nbsp;</div>\",\n                \"recipients\": [],\n                \"fullname\": \"Xavier A Villarroel\",\n                \"email\": \"support@central-supportdesk.kayako.com\",\n                \"creator\": {\n                    \"id\": 20,\n                    \"resource_type\": \"user\"\n                },\n                \"identity\": {\n                    \"id\": 21,\n                    \"resource_type\": \"identity_email\"\n                },\n                \"mailbox\": {\n                    \"id\": 4,\n                    \"resource_type\": \"mailbox\"\n                },\n                \"attachments\": [],\n                \"download_all\": null,\n                \"locale\": null,\n                \"response_time\": 0,\n                \"created_at\": \"2025-09-04T19:51:10+00:00\",\n                \"updated_at\": \"2025-09-04T19:51:10+00:00\",\n                \"resource_type\": \"case_message\",\n                \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/60182386/messages/9677165\"\n            },\n            \"9677162\": {\n                \"id\": 9677162,\n                \"uuid\": \"d7abc332-fc23-40fa-b403-fa123766984d\",\n                \"subject\": \"DNN License Add-On for Suffolk County Govt\",\n                \"body_text\": \"Dear Customer,\\n\\nThank you for bringing this matter to our attention. We have escalated the approval notification issue related to account 221013 – Vanderbilt University Medical Center to our Professional Services team. \\n\\nThey will perform a detailed investigation to identify why the notifications are being sent incorrectly and work on applying the necessary fix.\\n\\nRest assured that we will keep you informed of any progress, and we will notify you immediately once the issue has been resolved.\\n\\nKind regards,\\nXavier Villarroel\\n@Hand Support Team\",\n                \"body_html\": \"<div>Dear Customer,</div><div><br></div><div>Thank you for bringing this matter to our attention. We have escalated the approval notification issue related to account <strong data-end=\\\"788\\\" data-start=\\\"739\\\">221013 – Vanderbilt University Medical Center</strong> to our Professional Services team.&nbsp;</div><div><br></div><div>They will perform a detailed investigation to identify why the notifications are being sent incorrectly and work on applying the necessary fix.</div><div><br></div><div>Rest assured that we will keep you informed of any progress, and we will notify you immediately once the issue has been resolved.</div><div><br></div><div>Kind regards,<br data-start=\\\"1117\\\" data-end=\\\"1120\\\">Xavier Villarroel<br data-start=\\\"1137\\\" data-end=\\\"1140\\\">@Hand Support Team</div>\",\n                \"recipients\": [],\n                \"fullname\": \"Xavier A Villarroel\",\n                \"email\": \"support@central-supportdesk.kayako.com\",\n                \"creator\": {\n                    \"id\": 20,\n                    \"resource_type\": \"user\"\n                },\n                \"identity\": {\n                    \"id\": 21,\n                    \"resource_type\": \"identity_email\"\n                },\n                \"mailbox\": {\n                    \"id\": 4,\n                    \"resource_type\": \"mailbox\"\n                },\n                \"attachments\": [],\n                \"download_all\": null,\n                \"locale\": null,\n                \"response_time\": 0,\n                \"created_at\": \"2025-09-04T19:50:17+00:00\",\n                \"updated_at\": \"2025-09-04T19:50:17+00:00\",\n                \"resource_type\": \"case_message\",\n                \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/60182386/messages/9677162\"\n            },\n            \"9666112\": {\n                \"id\": 9666112,\n                \"uuid\": \"795facc0-11f2-43e7-b34b-f3d4747dd579\",\n                \"subject\": \"DNN License Add-On for Suffolk County Govt\",\n                \"body_text\": \"Dear Customer,\\n\\nThank you for your message regarding the additional non-production licenses. We appreciate you sharing the relevant details and contacts.\\n\\nYour request will be carefully reviewed. If any further information is needed, we will reach out to you.\\n\\nSincerely, \\nHermes \\nDNN Support Team\",\n                \"body_html\": \"Dear Customer,<br><br>Thank you for your message regarding the additional non-production licenses. We appreciate you sharing the relevant details and contacts.<br><br>Your request will be carefully reviewed. If any further information is needed, we will reach out to you.<br><br>Sincerely,  <br>Hermes  <br>DNN Support Team\",\n                \"recipients\": [],\n                \"fullname\": \"Hermes\",\n                \"email\": \"support@central-supportdesk.kayako.com\",\n                \"creator\": {\n                    \"id\": 1457,\n                    \"resource_type\": \"user\"\n                },\n                \"identity\": {\n                    \"id\": 1458,\n                    \"resource_type\": \"identity_email\"\n                },\n                \"mailbox\": {\n                    \"id\": 4,\n                    \"resource_type\": \"mailbox\"\n                },\n                \"attachments\": [],\n                \"download_all\": null,\n                \"locale\": null,\n                \"response_time\": 0,\n                \"created_at\": \"2025-08-29T19:45:27+00:00\",\n                \"updated_at\": \"2025-08-29T19:45:27+00:00\",\n                \"resource_type\": \"case_message\",\n                \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/60182386/messages/9666112\"\n            }\n        },\n        \"case_priority\": {\n            \"3\": {\n                \"id\": 3,\n                \"label\": \"High\",\n                \"level\": 3,\n                \"created_at\": \"2024-11-08T19:13:58+00:00\",\n                \"updated_at\": \"2025-03-13T15:55:34+00:00\",\n                \"resource_type\": \"case_priority\",\n                \"resource_url\": \"https://central-supportdesk.kayako.com/api/v1/cases/priorities/3\"\n            },\n            \"1\": {\n                \"id\": 1,\n                \"label\": \"Low\",\n                \"level\": 1,\n                \"created_at\": \"2024-11-08T19:13:58+00:00\",\n                \"updated_at\": \"2025-03-13T15:55:34+00:00\",\n                \"resource_type\": \"case_priority\",\n                \"resource_url\": \"https://support.alpha.school/api/v1/cases/priorities/1\"\n            },\n            \"2\": {\n                \"id\": 2,\n                \"label\": \"Normal\",\n                \"level\": 2,\n                \"created_at\": \"2024-11-08T19:13:58+00:00\",\n                \"updated_at\": \"2025-03-13T15:55:34+00: